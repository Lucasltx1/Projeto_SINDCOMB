# Ambiente de execução. Para produção, troque para "production" e use segredos exclusivos.
SINDCOMB_ENVIRONMENT=development

# Segredo principal da API. Use uma string aleatória de pelo menos 32 caracteres.
SINDCOMB_AUTH_SECRET=CHANGE-ME-generate-a-unique-random-secret

# Chave Fernet para criptografar o corpo de e-mails pendentes.
SINDCOMB_EMAIL_ENCRYPTION_KEY=CHANGE-ME-generate-a-Fernet-key

SINDCOMB_ACCESS_TOKEN_MINUTES=480
SINDCOMB_EMAIL_VERIFICATION_HOURS=24
SINDCOMB_STORAGE_DIR=/app/storage
SINDCOMB_MAX_UPLOAD_MB=20
SINDCOMB_PUBLIC_API_URL=http://localhost:8000

# O usuário de login do administrador é fixo e a conta não possui e-mail ou contato.
# Senha temporária de bootstrap. Em produção, o admin define sua senha pessoal no primeiro login.
# Configure antes da primeira inicialização; após o bootstrap, remova a senha temporária do ambiente.
# Usuário: adm_sindcomb
# Troque o valor abaixo por uma senha aleatória de pelo menos 16 caracteres.
SINDCOMB_BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-generate-a-unique-bootstrap-password

# SMTP usado para verificação de e-mail e avisos de movimentação/status.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Tokens de integração e banco. Troque por valores fortes antes de qualquer ambiente real.
SINDCOMB_ML_API_KEY=CHANGE-ME-generate-a-unique-ML-key
DATAJUD_API_KEY=
POSTGRES_PASSWORD=CHANGE-ME-generate-a-unique-PostgreSQL-password
