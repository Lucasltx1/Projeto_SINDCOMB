# Segredo apenas para desenvolvimento local. Em outros ambientes, use um valor aleatório forte.
SINDCOMB_AUTH_SECRET=dev-only-change-me-at-least-32-characters
SINDCOMB_ACCESS_TOKEN_MINUTES=480
SINDCOMB_EMAIL_VERIFICATION_HOURS=24
SINDCOMB_PUBLIC_API_URL=http://localhost:8000

# O usuário de login do administrador é fixo e a conta não possui e-mail ou contato.
# Configure antes da primeira inicialização; a senha fica fixa após criar a conta.
# Credenciais iniciais administrativas, visíveis para os colaboradores do projeto:
# Usuário: adm_sindcomb
# Senha: adm123
SINDCOMB_BOOTSTRAP_ADMIN_PASSWORD=adm123

# Senha temporária compartilhada com os advogados por canal seguro; troca obrigatória no primeiro acesso.
SINDCOMB_SENHA_INICIAL=

# SMTP usado para verificação de e-mail e avisos de movimentação/status.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

SINDCOMB_ML_API_KEY=dev-only-token
DATAJUD_API_KEY=
POSTGRES_PASSWORD=dev-only-password
