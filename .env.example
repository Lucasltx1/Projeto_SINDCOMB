# Copie este arquivo para .env e substitua todos os valores CHANGE-ME antes de iniciar.
SINDCOMB_ENVIRONMENT=development
SINDCOMB_AUTH_SECRET=CHANGE-ME-generate-a-unique-random-secret
SINDCOMB_EMAIL_ENCRYPTION_KEY=CHANGE-ME-generate-a-Fernet-key
SINDCOMB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SINDCOMB_ACCESS_TOKEN_MINUTES=60
SINDCOMB_EMAIL_VERIFICATION_HOURS=24
SINDCOMB_PASSWORD_RESET_HOURS=1
SINDCOMB_PASSWORD_RESET_COOLDOWN_SECONDS=60
SINDCOMB_STORAGE_DIR=./storage
SINDCOMB_MAX_UPLOAD_MB=20
SINDCOMB_PUBLIC_API_URL=http://localhost:8000
SINDCOMB_PUBLIC_APP_URL=http://localhost:3000
SINDCOMB_SYNC_INTERVAL_MINUTES=60
SINDCOMB_SYNC_FAILURE_RETRY_MINUTES=5
SINDCOMB_SYNC_INITIAL_DELAY_SECONDS=30
SINDCOMB_SYNC_MAX_ATTEMPTS=3
SINDCOMB_SYNC_RETRY_BASE_SECONDS=2
SINDCOMB_WORKER_POLL_SECONDS=15
SINDCOMB_EMAIL_MAX_ATTEMPTS=8
SINDCOMB_EMAIL_RETRY_BASE_SECONDS=60
SINDCOMB_EMAIL_RETRY_MAX_SECONDS=3600

# O login administrativo é adm_sindcomb. Defina uma senha única com 16+ caracteres
# antes da primeira inicialização; após o bootstrap o app não altera essa senha.
SINDCOMB_BOOTSTRAP_ADMIN_PASSWORD=

# SMTP usado para verificação de e-mail e avisos de movimentação/status.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

SINDCOMB_ML_API_KEY=CHANGE-ME-generate-a-unique-ML-key
DATAJUD_API_KEY=
POSTGRES_PASSWORD=CHANGE-ME-generate-a-unique-PostgreSQL-password
